{
  "version": "2.0",
  "logging": {
    "applicationInsights": {
      "samplingSettings": {
        "isEnabled": true,
        "excludedTypes": "Request"
      }
    }
  },
  "extensionBundle": {
    "id": "Microsoft.Azure.Functions.ExtensionBundle",
    "version": "[4.*, 5.0.0)"
  },
  "extensions": {
    "serviceBus": {
        "clientRetryOptions":{
            "mode": "exponential",
            "delay": "00:00:10.00",
            "maxDelay": "00:10:00",
            "maxRetries": 5
        },
        "maxConcurrentCalls": 16,
        "maxConcurrentSessions": 8
    }
}
}